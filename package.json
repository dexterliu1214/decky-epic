{
  "name": "decky-epic",
  "version": "0.1.0",
  "description": "Download and play Epic Games Store titles on Steam Deck with Epic cloud-save sync, a Steam-like library, and Metacritic sorting.",
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "epic-games",
    "legendary",
    "cloud-save"
  ],
  "author": "dexterliu1214",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.7.0",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.11.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "rollup": "^4.21.0",
    "shx": "^0.3.4",
    "tslib": "^2.7.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "qrcode-generator": "^1.4.4",
    "react-icons": "^5.3.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
